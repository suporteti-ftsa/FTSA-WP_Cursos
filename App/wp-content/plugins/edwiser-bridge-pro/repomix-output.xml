					$( ".wdm_new_qty_per_prod" ).html( $( this ).val() );
					$( ".wdm_new_qty_per_new_prod" ).html( $( this ).val() );
					var grandTotal = calculateGrantTotal();
					$( "#add-quantity-total-price" ).html( grandTotal.toFixed( 2 ) );
				}
			);

