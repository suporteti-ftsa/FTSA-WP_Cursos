	public function handle_order_complete( $order_id ) {

		if ( ! empty( $order_id ) ) {
			$order        = wc_get_order( $order_id ); // Get Order details.
			$is_processed = $order->get_meta( '_is_processed', true );

			if ( ! empty( $is_processed ) ) {
