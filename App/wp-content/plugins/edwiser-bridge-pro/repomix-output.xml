    height: 40px;
    padding: 0.5em 1em;
    border-radius: 0.25em;
    background: #f75d25;
    font-weight: 600;
    font-size: 0.875rem;
    color: #fff;
    transition: all 0.3s ease;
    box-shadow: none !important;

    &:hover {
      background: hsl(16, 93%, 56%, 0.9);
    }
  }

  .eb-cart__wrapper {
    display: flex;
    flex-direction: column;
    gap: 2em;
    max-width: 1190px;
    width: 100%;
    background: #fff;
    border-radius: 1rem;
    border: 1px solid #e5e5e5;
    padding: 1.5em;
    margin: 0 auto !important;

    .eb-cart__left {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2em;

      .eb-cart__left-header {
        display: flex;
        flex-direction: column;
        gap: 1em;
      }
    }

    .eb-cart__right {
      flex: 1;
    }
  }

  .eb-title {
    font-family: Segoe UI;
    font-size: 2rem;
    line-height: 2.625rem;
    font-weight: 700;
    color: #283b3c;
  }

  .eb-cart__total-items {
    color: #4b5858;
    font-size: 1rem;
    font-weight: 600;

    span {
      color: #283b3c;
    }
