  .eb-checkout__shipping-options {
    display: flex;
    flex-direction: column;
    gap: 1.5em;

    .shipping-options__header {
      .shipping-options__title {
        font-weight: 600;
        font-size: 20px;
        line-height: 28px;
        color: #283b3c;
      }
