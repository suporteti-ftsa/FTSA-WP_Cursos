	 */
	function triggerLogout( $mdl_uid ) {
		if ( is_user_logged_in() ) {
			$wp_mdl_uid = get_user_meta( get_current_user_id(), 'moodle_user_id', true );
			if ( $wp_mdl_uid && $wp_mdl_uid == $mdl_uid ) { // @codingStandardsIgnoreLine
				wp_logout();
			}
		}
	}
}

