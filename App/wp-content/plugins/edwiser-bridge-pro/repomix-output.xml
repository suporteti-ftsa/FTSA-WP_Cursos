  .mantine-Select-section {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: #385b5c;
  }

  .mantine-Select-section[data-position='left'] {
    left: 10px;
