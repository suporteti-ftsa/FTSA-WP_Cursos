			case 'associated_courses':
				$courses  = $this->get_associated_course_title( $post_id );
				$iterator = 0;
				if ( ! empty( $courses ) ) {
					$courses_count = count( $courses );
					foreach ( $courses as $value ) {
						if ( ++$iterator === $courses_count ) {
							echo $value; // @codingStandardsIgnoreLine
						} else {
							echo $value . ', '; // @codingStandardsIgnoreLine
						}
					}
				} else {
