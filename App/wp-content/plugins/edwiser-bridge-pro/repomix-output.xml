			$mdl_enroll = $wpdb->prefix . 'moodle_enrollment';
			$result     = $wpdb->get_col( $wpdb->prepare( "select course_id from {$mdl_enroll} where user_id=%d", $user_id ) ); // @codingStandardsIgnoreLine
