							<h4><?php esc_attr_e( 'Available courses', 'edwiser-bridge-pro' ); ?></h4>
						</div>
					<?php

					$content = ob_get_clean();

					echo apply_filters( 'bridge_woo_variation_associated_courses', $content ); // @codingStandardsIgnoreLine
				}
			}
		}
