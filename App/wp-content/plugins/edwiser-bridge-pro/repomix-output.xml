    .custom-fields__header {
      & > * + * {
        margin-top: 0.5em !important;
      }

      .custom-fields__title {
        font-weight: 600;
        font-size: 20px;
        line-height: 28px;
        color: #283b3c;
      }

      .custom-fields__sub-title {
        font-weight: 400;
        font-size: 14px;
        line-height: 20px;
