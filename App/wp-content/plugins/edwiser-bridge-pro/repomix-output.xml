        $user_id = intval($params['user_id']);
        $cohort_id = intval($params['cohort_id']);

        $cohort_details = includes\bulkPurchase\get_cohort_details($cohort_id);
        if (isset($cohort_details['courses'])) {
            $courses = $cohort_details['courses'];
