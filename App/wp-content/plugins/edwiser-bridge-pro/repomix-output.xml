  .eb-cart__checkbox-group {
    display: grid;
    gap: 0.25em;

    .eb-cart__checkbox-group-error,
    .eb-cart__checkbox-group-warning {
      display: block;
      font-weight: 400;
      font-size: 0.875rem;
      line-height: 1.5;
      margin-left: 0.125em !important;
      padding: 8px;
      border-radius: 0 4px 4px 0;
      border-left: 3px solid;
      margin-top: 8px;

      ul {
        margin: 0;
        padding-left: 1.5em;
        list-style: disc;
        margin-top: 12px;
      }
    }

    .eb-cart__checkbox-group-error {
      color: #dd1405;
      background: rgb(221, 20, 5, 0.1);
    }

    .eb-cart__checkbox-group-warning {
      color: #eab308;
      background: rgb(234, 179, 8, 0.1);
    }
