						var eachValue = $( this ).val();
						arr.push( eachValue )
						// alert(eachValue);
					}
				);
				return arr;
			}

			/**
			 * Functionality to calculate the grand total in the add more product/quantity popup.
			 *
			 * @returns {Number}
			 */
			function calculateGrantTotal() {
				var total = 0;
				$( '.wdm-quantity-total' ).each(
					function (event) {
						total += parseFloat( $( this ).text() );
					}
				);
				return total;
			}

