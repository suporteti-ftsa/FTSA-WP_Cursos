    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 20px;
    background: hsl(16, 93%, 56%, 0.1);
    border-radius: 8px;

    p {
      font-size: 16px;
      line-height: 24px;
      font-weight: 600;
      color: #273e3f;
    }

    a {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 0.5em 1em;
      border-radius: 0.25em;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.25rem;
      transition: all 0.3s ease;
      box-shadow: none !important;
      border: 1px solid #f75d25;
      background: #f75d25;
      color: #fff;
      text-decoration: none;

      &:hover {
        background: hsl(16, 93%, 56%, 0.9);
      }
