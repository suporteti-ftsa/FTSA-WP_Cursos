    cartItems,
    cartTotal,
    itemCount,
    couponsEnabled,
    cartCoupon,
    loadingCartItems,
    loadingCartTotal,
    shopPageUrl,
    checkoutUrl,
    includesTax,
    singleTaxTotal,
    handleQuantityUpdate,
    handleRemoveItem,
    handleApplyCoupon,
    handleRemoveCoupon,
    shippingAddress,
