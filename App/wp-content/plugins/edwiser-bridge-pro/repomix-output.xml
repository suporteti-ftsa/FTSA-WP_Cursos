  .eb-group-management__actions {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 1em;

    .actions__select-group {
      width: 100%;
    }

    .actions__btn {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 0.75em;
    }

    .btn__add-product,
    .btn__add-quantity,
    .btn__delete-group {
      background: transparent;
      padding: 0.5em 1em;
      border-radius: 0.25em;
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.25rem;
      transition: all 0.3s ease;
      box-shadow: none !important;
    }

    .btn__add-product,
    .btn__add-quantity {
      color: #f75d25;
      border: 1px solid #f75d25;

      &:hover {
        background: #f75d25;
        color: #fff;
      }

      &:disabled {
        cursor: not-allowed;
        border: 1px solid #d6d8e7;
        color: #819596;

        &:hover {
          background: transparent;
          color: #819596;
        }
      }
    }

    .btn__delete-group {
      border: 0;
      color: #dd1405;
      border: 1px solid transparent;
      margin-left: 20px;

      &:hover {
        background: hsl(4, 96%, 44%, 0.1);
        color: #dd1405;
      }

      &:disabled {
        cursor: not-allowed;
        color: #819596;

        &:hover {
          background: transparent;
          color: #819596;
        }
      }
    }

    .btn__action-confirm,
    .btn__action-cancel {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 0.5em 1em;
      border-radius: 0.375em;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.25rem;
      transition: all 0.3s ease;
      box-shadow: none !important;

      &:disabled {
        cursor: not-allowed;
        opacity: 0.4;
      }
    }

    .btn__action-cancel {
      border: 1px solid #dbdbdb;
      background: transparent;
      color: #283b3c;

      &:hover {
        background: #dbdbdb;
      }
    }

    .actions__product-modal {
      .product-modal__error {
        width: 100%;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 400;
        font-size: 14px;
        line-height: 20px;
        color: #283b3c;
        margin-bottom: 20px;
        border: 1px solid #dd1405;
        background: #fdedeb;
      }

      .product-modal__content {
