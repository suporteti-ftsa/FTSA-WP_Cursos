  .mantine-Checkbox-icon {
    margin: auto !important;
    position: absolute;
    inset: 0;
    width: 60%;
    margin: auto;
    color: #fff;
    pointer-events: none;
    transform: translateY(0.3125rem) scale(0.5);
    opacity: 0;
    transition:
